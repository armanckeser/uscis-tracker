DATABASE_URL=postgresql://postgres:password@localhost:5435/app
PORT=4000
# The address you open the tracker at. The API refuses calls from anywhere else.
APP_ORIGIN=https://uscis.example.com
POLLER_ENABLED=true
POLLER_INTERVAL_MS=1800000
POLL_ON_START=true

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:uscis-tracker@localhost

# Visa bulletin dataset: an http(s) URL or a local directory holding visa_bulletin.json,
# uscis_chart.json and processing_times.csv (for example tests/fixtures).
# VISA_BULLETIN_BASE_URL=https://raw.githubusercontent.com/armanckeser/visa-bulletin-data/main/data
# BULLETIN_SYNC=false
